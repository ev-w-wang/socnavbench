# policy configurations for robot

[mppi]
# GPU 4096-sample profile. See tests/mppi_tuning/gpu4096/NOTES.txt
use_gpu = true
gpu_device = auto
compile_gpu_rollout = false
seed = 991
horizon = 60
num_iterations = 2
num_samples = 4096
temp = 10.0
std_v = 0.45
std_w = 0.9
dt = 0.05
dynamic_history_len = 20
v_min = 0.0
v_max = 1.2
w_min = -1.1
w_max = 1.1
goal_radius = 0.3
goal_weight = 10.0
terminal_goal_weight = 100.0
goal_bonus = 125.0
progress_weight = 5.0
heading_weight = 2.0
desired_speed = 1.0
goal_speed_gain = 1.0
slowdown_radius = 1.0
speed_weight = 2.0
stop_speed_weight = 5.0
control_effort_weight = 1.0
control_smoothing_weight = 0.5
action_noise_beta = 0.85
initial_sequence = goal_directed
initial_sequence_speed_fraction = 0.5
initial_sequence_angular_fraction = 1.0
static_obs_clearance = 0.2
static_obs_weight = 200.0
dynamic_obs_clearance = 0.55
dynamic_obs_weight = 750.0
# Prediction-risk envelope. Longitudinal uncertainty grows 0.10 m/s and
# lateral uncertainty grows half as quickly. A 2-sigma Gaussian places 13.5%
# of the center cost at the ellipse boundary. These initial shape parameters
# are intentionally conservative starting points, not calibrated values.
dynamic_uncertainty_growth = 0.10
dynamic_uncertainty_longitudinal_scale = 1.0
dynamic_uncertainty_lateral_scale = 1.0
dynamic_uncertainty_sigma_level = 2.0
dynamic_uncertainty_discount = 0.10
dynamic_time_smear_steps = 3
dynamic_time_smear_tau = 0.10
# Supported: orca, constant_velocity, ground_truth (oracle evaluation only)
dynamic_prediction_method = orca
orca_neighbor_dist = 10.0
orca_max_neighbors = 10
orca_time_horizon = 5.0
orca_time_horizon_obst = 5.0

[mppi_99_sr_7_21_2300]
horizon = 35
num_iterations = 10
num_samples = 100
temp = 0.75
std_v = 0.2
std_w = 0.7
dt = 0.25
dynamic_history_len = 20
v_min = 0.0
v_max = 1.0
w_min = -2.84
w_max = 2.84
respect_v_pref = true
goal_radius = 0.3
goal_weight = 10.0
terminal_goal_weight = 100.0
goal_bonus = 300.0
progress_weight = 5.0
heading_weight = 2.0
desired_speed = 1.0
goal_speed_gain = 1.0
slowdown_radius = 1.0
speed_weight = 2.0
stop_speed_weight = 5.0
control_effort_weight = 1.0
static_obs_clearance = 0.2
static_obs_weight = 100.0
dynamic_obs_clearance = 0.2
dynamic_obs_weight = 100.0
dynamic_prediction_method = orca
orca_neighbor_dist = 10.0
orca_max_neighbors = 10
orca_time_horizon = 5.0
orca_time_horizon_obst = 5.0
